# Server Port (configured automatically by Cloud Run, defaults to 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Google Gemini AI API Key (Required for AI Tutor, Neuroscience planner, smart quiz generation)
# Obtain from Google AI Studio / Google Cloud Console
GEMINI_API_KEY=

# Application hosting URL (Cloud Run service URL or custom domain)
APP_URL=
